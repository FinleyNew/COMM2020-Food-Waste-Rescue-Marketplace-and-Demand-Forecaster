#Verify the collection_code generated is unique and follows your specified format and works on the collect_by_code function
def test_collection_code_generation_and_retrieval(mock_db, sample_seller, sample_bundle, sample_buyer):
    # Create a bundle to reserve
    created_bundle = bundles.create_bundle(
        seller_id=sample_seller["id"],
        title=sample_bundle["title"],
        available=sample_bundle["available"],
        price=sample_bundle["price"]
    )
    
    # Create a reservation for the bundle
    created_reservation = reservations.create_reservation(
        buyer_id=sample_buyer["id"],
        bundle_id=created_bundle.id,
        quantity=1
    )
    
    # Generate a collection code for the reservation
    collection_code = reservations.create_code(reservation_id=created_reservation.id)
    
    # Assertions to verify the collection code was generated correctly
    assert collection_code is not None
    assert isinstance(collection_code, str)
    assert len(collection_code) == 8  # Assuming the code should be 8 characters long - could change, ask fin


    #test that a reservation cannot be collected with an invalid code
    with pytest.raises(ValueError):
        reservations.collect_by_code(collection_code="INVALID")

    
    # Retrieve the reservation using the collection code
    retrieved_reservation = reservations.collect_by_code(collection_code=collection_code)
    
    # Assertions to verify the retrieved reservation matches the original one
    assert retrieved_reservation is not None
    assert retrieved_reservation.id == created_reservation.id
    assert retrieved_reservation.buyer_id == created_reservation.buyer_id
    assert retrieved_reservation.bundle_id == created_reservation.bundle_id
    #checks if bundle listing is removed from active listings after collection
    assert not bundles.is_available(bundle_id=created_bundle.id, db=mock_db)

    #Test entering a valid code that has already been used (should fail).
    with pytest.raises(ValueError):
        reservations.collect_by_code(collection_code=collection_code)

    
