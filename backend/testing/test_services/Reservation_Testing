import pytest
from app.services import bundles , reservations

def test_reservation_creation(mock_db, sample_seller, sample_bundle, sample_buyer):
    # Create a bundle to reserve
    created_bundle = bundles.create_bundle(
        seller_id=sample_seller["id"],
        title=sample_bundle["title"],
        available=sample_bundle["available"],
        price=sample_bundle["price"]
    )
    
    # Create a reservation for the bundle
    created_reservation = reservations.create_reservation(
        buyer_id=sample_buyer["id"],
        bundle_id=created_bundle.id,
        quantity=1
    )
    
    # Assertions to verify the reservation was created correctly
    assert created_reservation is not None
    assert created_reservation.buyer_id == sample_buyer["id"]
    assert created_reservation.bundle_id == created_bundle.id
    assert created_reservation.quantity == 1

    #test that a reservation with zero quantity cannot be made
    with pytest.raises(ValueError):
        reservations.create_reservation(
            buyer_id=sample_buyer["id"],
            bundle_id=created_bundle.id,
            quantity=0
        )
    #test that a reservation with negative quantity cannot be made
    with pytest.raises(ValueError):
        reservations.create_reservation(
            buyer_id=sample_buyer["id"],
            bundle_id=created_bundle.id,
            quantity=-1
        )

#Tests that a reservation cannot be made for a bundle that has no availability left
def test_reservation(mock_db, sample_seller, sample_bundle, sample_buyer):
    # Create a bundle with only 1 available
    created_bundle = bundles.create_bundle(
        seller_id=sample_seller["id"],
        title=sample_bundle["title"],
        available=1,
        price=sample_bundle["price"]
    )
    
    # Simulate two buyers trying to reserve the last bundle at the same time
    buyer1 = {"id": 1}
    buyer2 = {"id": 2}
    
    # Create the first reservation (should succeed)
    reservation1 = reservations.create_reservation(
        buyer_id=buyer1["id"],
        bundle_id=created_bundle.id,
        quantity=1
    )
    
    # Try to create a second reservation for the same bundle (should fail)
    with pytest.raises(ValueError):
        reservations.create_reservation(
            buyer_id=buyer2["id"],
            bundle_id=created_bundle.id,
            quantity=1
        )

